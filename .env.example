# Admin access for /admin/* pages
ADMIN_PASSWORD=change-me
# Production manager access for /admin/tanvi
PRODUCTION_MANAGER_PASSWORD=
# Built-in partner desk passwords
YAN_PARTNER_PASSWORD=
SHABBANAZ_PARTNER_PASSWORD=
# Optional: separate signing secret for admin session cookies
# ADMIN_SESSION_SECRET=

# Optional: enable GA4 event/page tracking on public pages
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Firebase web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_ID=modatabase
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional owner Firebase Auth email override (defaults to motshirtmauritius@gmail.com).
# Managed admins use their own login email.
NEXT_PUBLIC_FIREBASE_ADMIN_EMAIL=
# Optional admin display limit for Firebase Storage usage bar (defaults to 5 GB)
NEXT_PUBLIC_FIREBASE_STORAGE_LIMIT_GB=5

# Optional host footprint label + limit for the admin settings storage bar
HOSTING_PROVIDER_LABEL=Vercel
HOSTING_STORAGE_LIMIT_GB=1

# Docker PostgreSQL admin test page (/admin/docker-postgres)
# Server-side profile storage (use your hosted PostgreSQL connection in production)
DATABASE_URL=
# PostgreSQL plan capacity used by the Database progress bar (defaults to 512 MB)
POSTGRES_STORAGE_LIMIT_MB=512
# Start with: npm run docker:postgres
POSTGRES_TEST_DATABASE_URL=postgresql://mo_tshirt:mo_tshirt_dev@localhost:54329/mo_tshirt_docker_test

# SMTP email delivery
# Use the same verified Gmail/mailbox address for SMTP_USER and the address inside SMTP_FROM.
# Do not leave SMTP_FROM as "MO T-SHIRT <>" because Gmail can flag that as suspicious.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=motshirtmauritius@gmail.com
SMTP_PASS=
SMTP_FROM=MO T-SHIRT <motshirtmauritius@gmail.com>
# Secret used to sign the Accept / Request changes / Reject links in quotation emails.
# Generate a long random value and keep it server-side only.
QUOTE_RESPONSE_SECRET=

# Gmail read access for /admin/tracking quotation email counts.
# Create OAuth credentials with Gmail readonly scope and store a refresh token for the mailbox.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Use "me" for the OAuth mailbox, or set the Gmail address if needed.
GMAIL_QUOTATION_USER=me

# Tuya Cloud (EU by default)
TUYA_BASE_URL=https://openapi.tuyaeu.com
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
# Optional aliases accepted by server code:
# TUYA_ACCESS_ID=
# TUYA_ACCESS_SECRET=
TUYA_PROJECT_CODE=
TUYA_DEVICE_IDS=bfd52b965f5bb80646inny

# Scheduler auth for /api/tuya/automations/tick (Vercel Cron bearer secret)
CRON_SECRET=
# Optional alias:
# IOT_CRON_SECRET=

# OpenClaw is disabled unless explicitly enabled.
OPENCLAW_ENABLED=0

# Shared secret for OpenClaw -> Tuya control requests
OPENCLAW_TUYA_SECRET=

# Optional: Meta-style webhook verification token for /api/openclaw/whatsapp
OPENCLAW_WHATSAPP_VERIFY_TOKEN=
# Optional demo overrides
OPENCLAW_WHATSAPP_PROVIDER=mock
OPENCLAW_WHATSAPP_TRIGGER_MESSAGE=Hi, analyse all client requests.
OPENCLAW_WHATSAPP_THINKING_MIN_MS=2000
OPENCLAW_WHATSAPP_THINKING_MAX_MS=3000
OPENCLAW_WHATSAPP_TYPING_INDICATOR=1

# Optional Twilio WhatsApp delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+10000000000

# Optional Meta WhatsApp Cloud API delivery
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
