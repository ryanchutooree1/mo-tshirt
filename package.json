{
  "name": "mo-t-shirt",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "NEXT_DISABLE_TURBOPACK=1 next dev",
    "build": "next build",
    "preview": "next build && next start",
    "start": "next start",
    "docker:postgres": "docker compose -f docker-compose.postgres.yml up -d",
    "docker:postgres:down": "docker compose -f docker-compose.postgres.yml down",
    "docker:gemma": "docker compose -f docker-compose.gemma.yml up -d",
    "docker:gemma:down": "docker compose -f docker-compose.gemma.yml down",
    "clean": "rm -rf .next",
    "lint": "eslint",
    "ggt:on": "zsh ./scripts/ggt-light-on.sh",
    "ai:train": "node --no-warnings scripts/ai-train.mjs",
    "ai:reindex": "node --no-warnings scripts/ai-reindex.mjs",
    "ai:evaluate": "node --no-warnings scripts/ai-evaluate.mjs",
    "test:ai-assistant": "node --no-warnings --test tests/ai-assistant.test.mjs",
    "test:pricing": "node --test tests/pricing.test.js",
    "postbuild": "next-sitemap"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@types/pg": "^8.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.2.1",
    "framer-motion": "^12.23.12",
    "heic2any": "^0.0.4",
    "jspdf": "^3.0.2",
    "lucide": "^0.542.0",
    "lucide-react": "^0.542.0",
    "next": "16.2.1",
    "next-sitemap": "^4.2.3",
    "nodemailer": "^7.0.6",
    "onnxruntime-web": "^1.21.0",
    "pg": "^8.21.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.5.0",
    "recharts": "^3.1.2",
    "swiper": "^11.2.10",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/qrcode.react": "^1.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
