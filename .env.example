# Admin access for /admin/* pages
ADMIN_PASSWORD=change-me
# Optional: separate signing secret for admin session cookies
# ADMIN_SESSION_SECRET=

# Optional: enable GA4 event/page tracking on public pages
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Firebase web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Auth email/password admin account used for Storage access
NEXT_PUBLIC_FIREBASE_ADMIN_EMAIL=

# Tuya Cloud (EU by default)
TUYA_BASE_URL=https://openapi.tuyaeu.com
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
# Optional aliases accepted by server code:
# TUYA_ACCESS_ID=
# TUYA_ACCESS_SECRET=
TUYA_PROJECT_CODE=
TUYA_DEVICE_IDS=bfd52b965f5bb80646inny

# Scheduler auth for /api/tuya/automations/tick (Vercel Cron bearer secret)
CRON_SECRET=
# Optional alias:
# IOT_CRON_SECRET=
